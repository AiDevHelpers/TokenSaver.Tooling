{
  "TokenSaver": {
    "OllamaUrl": "http://localhost:11435",
    "OllamaModel": "HelperModel",
    "Debugger": {
      "EventCapture": {
        "Enabled": true,
        "MaxEventsInMemory": 10000,
        "EventPersistence": {
          "Enabled": false,
          "LogDirectory": "%ProgramData%\\TokenSaver\\debugger-logs",
          "MaxLogFileSizeMb": 100,
          "RetentionDays": 30
        },
        "Streaming": {
          "Enabled": true,
          "MaxSubscriptions": 50,
          "MaxEventsPerSecond": 1000
        }
      },
      "ProblemCapture": {
        "Enabled": true,
        "MaxProblemsInMemory": 5000,
        "ProblemPersistence": {
          "Enabled": false,
          "LogDirectory": "%ProgramData%\\TokenSaver\\problem-logs",
          "MaxLogFileSizeMb": 50,
          "RetentionDays": 30
        }
      },
      "ClientTracking": {
        "Enabled": true,
        "InactivityTimeoutMinutes": 30
      }
    }
  }
}
