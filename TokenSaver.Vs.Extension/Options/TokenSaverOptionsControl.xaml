<UserControl x:Class="TokenSaver.Vs.Extension.Options.TokenSaverOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">
    <StackPanel Margin="8">
        <TextBlock Text="Server" FontWeight="Bold" Margin="0,0,0,4" />
        <CheckBox x:Name="AutostartCheckBox" Content="Automatically start the TokenSaver MCP server" Margin="0,2" />
        <CheckBox x:Name="VerboseLoggingCheckBox" Content="Verbose logging" Margin="0,2" />

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server port" VerticalAlignment="Center" />
            <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Start timeout (s)" VerticalAlignment="Center" />
            <TextBox x:Name="StartTimeoutTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Idle timeout (s)" VerticalAlignment="Center" />
            <TextBox x:Name="IdleTimeoutTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
        </Grid>

        <TextBlock Text="DraftModel" FontWeight="Bold" Margin="0,12,0,4" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Loader.exe path" VerticalAlignment="Center" />
            <TextBox x:Name="DraftModelExePathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Health URL" VerticalAlignment="Center" />
            <TextBox x:Name="DraftModelHealthUrlTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Start timeout (s)" VerticalAlignment="Center" />
            <TextBox x:Name="DraftModelStartTimeoutTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
