<UserControl x:Class="TokenSaver.Vs.Extension.Options.TokenSaverOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">
    <StackPanel Margin="8">
        <TextBlock Text="Server" FontWeight="Bold" Margin="0,0,0,4" />
        <CheckBox x:Name="AutostartCheckBox" Content="Automatically start the TokenSaver MCP server" Margin="0,2" />
        <CheckBox x:Name="VerboseLoggingCheckBox" Content="Verbose logging" Margin="0,2" />

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server port" VerticalAlignment="Center" />
            <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Start timeout (s)" VerticalAlignment="Center" />
            <TextBox x:Name="StartTimeoutTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Idle timeout (s)" VerticalAlignment="Center" />
            <TextBox x:Name="IdleTimeoutTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
        </Grid>

        <TextBlock Text="SimpleModelServer" FontWeight="Bold" Margin="0,12,0,4" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Loader.exe path" VerticalAlignment="Center" />
            <TextBox x:Name="SimpleModelServerExePathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Health URL" VerticalAlignment="Center" />
            <TextBox x:Name="SimpleModelServerHealthUrlTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Start timeout (s)" VerticalAlignment="Center" />
            <TextBox x:Name="SimpleModelServerStartTimeoutTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
        </Grid>

        <TextBlock Text="MCP server (saved to ProgramData)" FontWeight="Bold" Margin="0,12,0,4" />
        <CheckBox x:Name="McpAutoRegisterProvidersCheckBox" Content="Auto-register providers" Margin="0,2" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ollama URL" VerticalAlignment="Center" />
            <TextBox x:Name="McpOllamaUrlTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ollama model" VerticalAlignment="Center" />
            <TextBox x:Name="McpOllamaModelTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="MCP server port" VerticalAlignment="Center" />
            <TextBox x:Name="McpServerPortTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Context size limit" VerticalAlignment="Center" />
            <TextBox x:Name="McpContextSizeLimitTextBox" Grid.Row="3" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Health check (s)" VerticalAlignment="Center" />
            <TextBox x:Name="McpHealthCheckIntervalTextBox" Grid.Row="4" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Workspace root" VerticalAlignment="Center" />
            <TextBox x:Name="McpWorkspaceRootTextBox" Grid.Row="5" Grid.Column="1" Margin="0,2" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Behavior config path" VerticalAlignment="Center" />
            <TextBox x:Name="McpBehaviorConfigPathTextBox" Grid.Row="6" Grid.Column="1" Margin="0,2" />
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
