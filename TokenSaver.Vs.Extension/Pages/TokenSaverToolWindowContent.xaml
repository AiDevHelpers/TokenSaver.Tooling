<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Margin="8">
        <TabControl.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
            <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}">
                <Setter Property="MinWidth" Value="90" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.CheckBoxStyleKey}}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ComboBoxStyleKey}}" />
            <!-- Cards: each section sits in its own bordered box with a tinted, accent-barred header. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="SubCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="10,0,10,10" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <!-- An empty sibling filled with text colour at low opacity: lighter on dark themes, darker on light ones. -->
            <Style x:Key="CardTint" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                <Setter Property="Opacity" Value="0.06" />
                <Setter Property="CornerRadius" Value="3,3,0,0" />
            </Style>
            <Style x:Key="CardHeader" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:VsBrushes.ControlLinkTextKey}}" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
                <Setter Property="Padding" Value="9,7,12,8" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="CardBody" TargetType="StackPanel">
                <Setter Property="Margin" Value="12,0,12,12" />
            </Style>
            <!-- Field labels: semibold in full text colour. Help text: normal weight in gray. -->
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,12,0,4" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Help" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>
            <Style x:Key="Err" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F14C4C" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Text" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The stock tab header is drawn in system colours; this one follows the Visual Studio theme. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="HeaderBorder" Padding="14,6" Background="Transparent"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="BorderBrush"
                                            Value="{DynamicResource {x:Static styles:VsBrushes.ControlLinkTextKey}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <TabItem Header="Settings">
            <Grid DataContext="{Binding Settings}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="4,12,12,12" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,12"
                                   Text="TokenSaver MCP server settings are saved to %ProgramData%\TokenSaver\appsettings.json and apply after the server restarts. Visual Studio extension settings apply straight away." />

                        <!-- Connection -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource CardTint}" />
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Connection" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="Where TokenSaver MCP listens and which model server it calls. Applies after restart." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Style="{StaticResource CardBody}">
                                    <TextBlock Style="{StaticResource Label}" Text="Model server URL" />
                                    <TextBox Text="{Binding ModelServerUrl}" AutomationProperties.Name="Model server URL" />
                                    <TextBlock Style="{StaticResource Help}" Text="The SimpleModelServer router that TokenSaver MCP calls for summaries. Default: http://localhost:11435" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding ModelServerUrlError}" />

                                    <TextBlock Style="{StaticResource Label}" Text="Helper model" />
                                    <TextBox Text="{Binding HelperModel}" AutomationProperties.Name="Helper model" />
                                    <TextBlock Style="{StaticResource Help}" Text="Name of the model used for summaries. Default: HelperModel" />

                                    <TextBlock Style="{StaticResource Label}" Text="MCP server port" />
                                    <TextBox Text="{Binding McpPort}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="MCP server port" />
                                    <TextBlock Style="{StaticResource Help}" Text="The port TokenSaver MCP listens on. The extension uses it for health checks. Default: 11436" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding McpPortError}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Features -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource CardTint}" />
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Features" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="What TokenSaver MCP does for you. Applies after restart." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Style="{StaticResource CardBody}">
                                    <CheckBox IsChecked="{Binding SummarizeOutput}" Margin="0,12,0,0" AutomationProperties.Name="Summarize tool output">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Summarize tool output" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Off: tools return raw, size-capped text." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding AllowTerse}" Margin="0,12,0,0" AutomationProperties.Name="Allow terse mode">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Allow terse mode" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Off: requests for terse answers are ignored." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding TrackSavings}" Margin="0,12,0,0" AutomationProperties.Name="Track token savings">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Track token savings" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Needed for the token savings reports." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding CleanPrompts}" Margin="0,12,0,0" AutomationProperties.Name="Clean prompts automatically">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Clean prompts automatically" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Removes duplicates and log noise from every tool call." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding BuildContextAtStartup}" Margin="0,12,0,0" AutomationProperties.Name="Build context at startup">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Build context at startup" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Off: context is built only when requested." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding RegisterWithClients}" Margin="0,12,0,0" AutomationProperties.Name="Register with AI clients">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Register with AI clients" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Adds the server to the configuration of supported AI clients." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding AutoWorkflow}" Margin="0,12,0,0" AutomationProperties.Name="Auto-workflow">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Auto-workflow" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Lets the server run its automatic code workflow (the auto code helper)." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ShowLogsOnQuery}" Margin="0,12,0,0" AutomationProperties.Name="Show logs the AI reads">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Show logs the AI reads" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Opens a Windows Terminal tab with the log whenever the AI queries a log file, so you can follow it too." />
                                        </StackPanel>
                                    </CheckBox>

                                    <TextBlock Style="{StaticResource Label}" Text="Run tests with" />
                                    <ComboBox ItemsSource="{Binding TestRunners}" SelectedItem="{Binding TestRunner}" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Run tests with" />
                                    <TextBlock Style="{StaticResource Help}" Text="Test Explorer, or dotnet test with TRX results." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Limits -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource CardTint}" />
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Limits" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="How much context TokenSaver builds. Applies after restart." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Style="{StaticResource CardBody}">
                                    <TextBlock Style="{StaticResource Label}" Text="Context limit (tokens)" />
                                    <TextBox Text="{Binding ContextLimit}" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Context limit" />
                                    <TextBlock Style="{StaticResource Help}" Text="Budget for the context TokenSaver builds. Default: 120000" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding ContextLimitError}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Extra model endpoints -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource CardTint}" />
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Extra model endpoints" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="Optional. With none listed, the model server URL above is used. Applies after restart." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Style="{StaticResource CardBody}">
                                    <TextBlock Style="{StaticResource Label}" Text="Endpoint selection" />
                                    <ComboBox ItemsSource="{Binding EndpointStrategies}" SelectedItem="{Binding EndpointStrategy}" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Endpoint selection" />
                                    <TextBlock Style="{StaticResource Help}" Text="Failover: use the primary, then the others if it is down. RoundRobin: rotate. Explicit: only the one a request names." />

                                    <ItemsControl ItemsSource="{Binding Endpoints}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SubCard}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Label}" Text="Name" />
                                                        <TextBox Text="{Binding Name}" AutomationProperties.Name="Endpoint name" />
                                                        <TextBlock Style="{StaticResource Label}" Text="URL" />
                                                        <TextBox Text="{Binding Url}" AutomationProperties.Name="Endpoint URL" />
                                                        <TextBlock Style="{StaticResource Label}" Text="Models (separated by commas)" />
                                                        <TextBox Text="{Binding Models}" AutomationProperties.Name="Endpoint models" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                            <CheckBox IsChecked="{Binding IsPrimary}" Content="Primary endpoint" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                            <Button Content="Remove" Command="{Binding RemoveCommand}" />
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Err}" Text="{Binding Error}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Add endpoint" Command="{Binding AddEndpointCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding EndpointsError}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Who may use the endpoint (TokenSaver Users group) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource CardTint}" />
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Users" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="Accounts in the TokenSaver Users group can read the endpoint token. Changes apply at once; they are not part of Save." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Style="{StaticResource CardBody}">
                                    <Button Content="Refresh" Command="{Binding RefreshUsersCommand}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Help}" Text="{Binding UsersStatus}" />
                                    <ItemsControl ItemsSource="{Binding AuthUsers}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}" MinWidth="72" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Account}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Label}" Text="Add another account (DOMAIN\name)" />
                                    <TextBox Text="{Binding NewUserAccount}" AutomationProperties.Name="Account to add" />
                                    <Button Content="Add user" Command="{Binding AddUserCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Visual Studio extension -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource CardTint}" />
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Visual Studio extension" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="How this extension starts and checks the services. Applies straight away." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Style="{StaticResource CardBody}">
                                    <CheckBox IsChecked="{Binding Autostart}" Margin="0,12,0,0" AutomationProperties.Name="Start the services when the extension loads">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Start the services when the extension loads" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Starts SimpleModelServer, then TokenSaver MCP, the first time you use TokenSaver in a Visual Studio session." />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ExtensionDebugLogging}" Margin="0,12,0,0" AutomationProperties.Name="Extension debug logging">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Extension debug logging" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Writes extra detail to the extension's log. Applies the next time the extension loads." />
                                        </StackPanel>
                                    </CheckBox>

                                    <TextBlock Style="{StaticResource Label}" Text="TokenSaver MCP start timeout (seconds)" />
                                    <TextBox Text="{Binding McpStartTimeout}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="TokenSaver MCP start timeout" />
                                    <TextBlock Style="{StaticResource Help}" Text="How long to wait for the service to start. Default: 30" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding McpStartTimeoutError}" />

                                    <TextBlock Style="{StaticResource Label}" Text="SimpleModelServer start timeout (seconds)" />
                                    <TextBox Text="{Binding SimpleModelServerStartTimeout}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="SimpleModelServer start timeout" />
                                    <TextBlock Style="{StaticResource Help}" Text="The first start can take minutes while models load. Default: 600" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding SimpleModelServerStartTimeoutError}" />

                                    <TextBlock Style="{StaticResource Label}" Text="SimpleModelServer health URL" />
                                    <TextBox Text="{Binding SimpleModelServerHealthUrl}" AutomationProperties.Name="SimpleModelServer health URL" />
                                    <TextBlock Style="{StaticResource Help}" Text="Checked to tell when SimpleModelServer is ready. Default: http://localhost:11435/health" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding SimpleModelServerHealthUrlError}" />

                                    <TextBlock Style="{StaticResource Label}" Text="SimpleModelServer program path" />
                                    <TextBox Text="{Binding SimpleModelServerExePath}" AutomationProperties.Name="SimpleModelServer program path" />
                                    <TextBlock Style="{StaticResource Help}" Text="Used by Start when the service is not installed. Blank: C:\Program Files\SimpleModelServer\SimpleModelServer.Server.exe" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Advanced -->
                        <Border Style="{StaticResource Card}">
                            <Expander Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}">
                                <Expander.Header>
                                    <StackPanel Margin="2,6">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Advanced" />
                                        <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0" Text="Rarely needed. Applies after restart." />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Style="{StaticResource CardBody}">
                                    <TextBlock Style="{StaticResource Label}" Text="Health check every (seconds)" />
                                    <TextBox Text="{Binding HealthCheckSeconds}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Health check interval" />
                                    <TextBlock Style="{StaticResource Help}" Text="How often the server checks its endpoints. Default: 30" />
                                    <TextBlock Style="{StaticResource Err}" Text="{Binding HealthCheckError}" />

                                    <TextBlock Style="{StaticResource Label}" Text="Workspace root" />
                                    <TextBox Text="{Binding WorkspaceRoot}" AutomationProperties.Name="Workspace root" />
                                    <TextBlock Style="{StaticResource Help}" Text="Blank: found automatically from the nearest .git folder or solution." />

                                    <TextBlock Style="{StaticResource Label}" Text="Behavior config override" />
                                    <TextBox Text="{Binding BehaviorConfigPath}" AutomationProperties.Name="Behavior config override" />
                                    <TextBlock Style="{StaticResource Help}" Text="For development: path to a different config.json. Blank: the workspace's own." />

                                    <CheckBox IsChecked="{Binding McpDebugLogging}" Margin="0,12,0,0" AutomationProperties.Name="MCP server debug logging">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="MCP server debug logging" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,1,0,0" Text="Sets the server's console log level to Debug." />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="4,8,12,4"
                        BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
                    <StackPanel>
                        <Border Padding="8,6" Margin="0,0,0,8" Background="{DynamicResource {x:Static styles:VsBrushes.InfoBackgroundKey}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RestartNotice}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RestartNotice}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static styles:VsBrushes.InfoTextKey}}" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Command="{Binding SaveCommand}" />
                            <Button Content="Discard changes" Command="{Binding DiscardCommand}" MinWidth="130" />
                            <Button Content="Restart MCP server" Command="{Binding RestartCommand}" MinWidth="140" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Services">
            <ScrollViewer DataContext="{Binding Services}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4" Width="620" HorizontalAlignment="Left">
                    <TextBlock Text="TokenSaver MCP server" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding McpStatus}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start" Command="{Binding StartMcpCommand}" />
                        <Button Content="Stop" Command="{Binding StopMcpCommand}" />
                        <Button Content="Restart" Command="{Binding RestartMcpCommand}" />
                        <Button Content="Install" Command="{Binding InstallMcpCommand}" />
                        <Button Content="Uninstall" Command="{Binding UninstallMcpCommand}" />
                    </StackPanel>

                    <TextBlock Text="SimpleModelServer" FontWeight="Bold" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding SimpleModelServerStatus}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start" Command="{Binding StartSimpleModelServerCommand}" />
                        <Button Content="Install" Command="{Binding InstallSimpleModelServerCommand}" />
                        <Button Content="Uninstall" Command="{Binding UninstallSimpleModelServerCommand}" />
                    </StackPanel>

                    <TextBlock Text="IDE bridge" FontWeight="Bold" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding BridgeStatus}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start" Command="{Binding StartBridgeCommand}" />
                        <Button Content="Stop" Command="{Binding StopBridgeCommand}" />
                    </StackPanel>

                    <TextBlock Text="Setup" FontWeight="Bold" Margin="0,18,0,4" />
                    <TextBlock Text="Full setup installs both services, waits until they respond, then opens the install prompt."
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Run full setup" Command="{Binding FullSetupCommand}" />
                        <Button Content="Open install prompt" Command="{Binding InstallPromptCommand}" />
                        <Button Content="Refresh status" Command="{Binding RefreshCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Logs">
            <Grid DataContext="{Binding Logs}" Margin="4,12,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Width="300" Margin="0,0,8,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
                    <CheckBox IsChecked="{Binding FollowNewest}" Content="Follow newest file" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <CheckBox IsChecked="{Binding NewestFirst}" Content="Newest line first" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,6" TextWrapping="Wrap" />

                <TextBox Grid.Row="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </TabItem>
    </TabControl>
</DataTemplate>
