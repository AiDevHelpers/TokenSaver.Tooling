<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Margin="8">
        <TabControl.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
            <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}">
                <Setter Property="MinWidth" Value="90" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.CheckBoxStyleKey}}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ComboBoxStyleKey}}" />
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Margin" Value="0,22,0,4" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,3" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Help" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>
            <Style x:Key="CheckHelp" TargetType="TextBlock" BasedOn="{StaticResource Help}">
                <Setter Property="Margin" Value="22,1,0,0" />
            </Style>
            <Style x:Key="Err" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F14C4C" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>
            <!-- The stock tab header is drawn in system colours; this one follows the Visual Studio theme. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="HeaderBorder" Padding="14,6" Background="Transparent"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="BorderBrush"
                                            Value="{DynamicResource {x:Static styles:VsBrushes.ControlLinkTextKey}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <TabItem Header="Settings">
            <Grid DataContext="{Binding Settings}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,12,12,12" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Help}" Margin="0"
                                   Text="TokenSaver MCP server settings are saved to %ProgramData%\TokenSaver\appsettings.json and apply after the server restarts. Visual Studio extension settings apply straight away." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Connection" />
                        <TextBlock Style="{StaticResource Label}" Text="Model server URL" />
                        <TextBox Text="{Binding ModelServerUrl}" />
                        <TextBlock Style="{StaticResource Help}" Text="The SimpleModelServer router that TokenSaver MCP calls for summaries. Default: http://localhost:11435" />
                        <TextBlock Style="{StaticResource Err}" Text="{Binding ModelServerUrlError}" />

                        <TextBlock Style="{StaticResource Label}" Text="Helper model" />
                        <TextBox Text="{Binding HelperModel}" />
                        <TextBlock Style="{StaticResource Help}" Text="Name of the model used for summaries. Default: HelperModel" />

                        <TextBlock Style="{StaticResource Label}" Text="MCP server port" />
                        <TextBox Text="{Binding McpPort}" MaxWidth="120" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Help}" Text="The port TokenSaver MCP listens on. The extension uses it for health checks. Default: 11436" />
                        <TextBlock Style="{StaticResource Err}" Text="{Binding McpPortError}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Features" />
                        <CheckBox IsChecked="{Binding SummarizeOutput}" Content="Summarize tool output" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Off: tools return raw, size-capped text." />
                        <CheckBox IsChecked="{Binding AllowTerse}" Content="Allow terse mode" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Off: requests for terse answers are ignored." />
                        <CheckBox IsChecked="{Binding TrackSavings}" Content="Track token savings" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Needed for the token savings reports." />
                        <CheckBox IsChecked="{Binding CleanPrompts}" Content="Clean prompts automatically" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Removes duplicates and log noise from every tool call." />
                        <CheckBox IsChecked="{Binding BuildContextAtStartup}" Content="Build context at startup" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Off: context is built only when requested." />
                        <CheckBox IsChecked="{Binding RegisterWithClients}" Content="Register with AI clients" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Adds the server to the configuration of supported AI clients." />
                        <CheckBox IsChecked="{Binding AutoWorkflow}" Content="Auto-workflow" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Lets the server run its automatic code workflow (the auto code helper)." />

                        <TextBlock Style="{StaticResource Label}" Text="Run tests with" />
                        <ComboBox ItemsSource="{Binding TestRunners}" SelectedItem="{Binding TestRunner}" MaxWidth="240" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Help}" Text="Test Explorer, or dotnet test with TRX results." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Limits" />
                        <TextBlock Style="{StaticResource Label}" Text="Context limit (tokens)" />
                        <TextBox Text="{Binding ContextLimit}" MaxWidth="160" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Help}" Text="Budget for the context TokenSaver builds. Default: 120000" />
                        <TextBlock Style="{StaticResource Err}" Text="{Binding ContextLimitError}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Extra model endpoints" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,4"
                                   Text="Optional. With none listed, the model server URL above is used." />
                        <TextBlock Style="{StaticResource Label}" Text="Endpoint selection" />
                        <ComboBox ItemsSource="{Binding EndpointStrategies}" SelectedItem="{Binding EndpointStrategy}" MaxWidth="240" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Help}" Text="Failover: use the primary, then the others if it is down. RoundRobin: rotate. Explicit: only the one a request names." />

                        <ItemsControl ItemsSource="{Binding Endpoints}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" Padding="10,2,10,10" Margin="0,4"
                                            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Name" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Label}" Text="URL" />
                                            <TextBox Text="{Binding Url}" />
                                            <TextBlock Style="{StaticResource Label}" Text="Models (separated by commas)" />
                                            <TextBox Text="{Binding Models}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <CheckBox IsChecked="{Binding IsPrimary}" Content="Primary endpoint" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <Button Content="Remove" Command="{Binding RemoveCommand}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Err}" Text="{Binding Error}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add endpoint" Command="{Binding AddEndpointCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Err}" Text="{Binding EndpointsError}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Visual Studio extension" />
                        <CheckBox IsChecked="{Binding Autostart}" Content="Start the services when the extension loads" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Starts SimpleModelServer, then TokenSaver MCP, the first time you use TokenSaver in a Visual Studio session." />
                        <CheckBox IsChecked="{Binding ExtensionDebugLogging}" Content="Extension debug logging" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource CheckHelp}" Text="Writes extra detail to the extension's log. Applies the next time the extension loads." />

                        <TextBlock Style="{StaticResource Label}" Text="TokenSaver MCP start timeout (seconds)" />
                        <TextBox Text="{Binding McpStartTimeout}" MaxWidth="120" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Help}" Text="How long to wait for the service to start. Default: 30" />
                        <TextBlock Style="{StaticResource Err}" Text="{Binding McpStartTimeoutError}" />

                        <TextBlock Style="{StaticResource Label}" Text="SimpleModelServer start timeout (seconds)" />
                        <TextBox Text="{Binding SimpleModelServerStartTimeout}" MaxWidth="120" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Help}" Text="The first start can take minutes while models load. Default: 600" />
                        <TextBlock Style="{StaticResource Err}" Text="{Binding SimpleModelServerStartTimeoutError}" />

                        <TextBlock Style="{StaticResource Label}" Text="SimpleModelServer health URL" />
                        <TextBox Text="{Binding SimpleModelServerHealthUrl}" />
                        <TextBlock Style="{StaticResource Help}" Text="Checked to tell when SimpleModelServer is ready. Default: http://localhost:11435/health" />
                        <TextBlock Style="{StaticResource Err}" Text="{Binding SimpleModelServerHealthUrlError}" />

                        <TextBlock Style="{StaticResource Label}" Text="SimpleModelServer program path" />
                        <TextBox Text="{Binding SimpleModelServerExePath}" />
                        <TextBlock Style="{StaticResource Help}" Text="Used by Start when the service is not installed. Blank: C:\Program Files\SimpleModelServer\SimpleModelServer.Server.exe" />

                        <Expander Margin="0,18,0,0">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="Advanced" />
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Style="{StaticResource Label}" Text="Health check every (seconds)" />
                                <TextBox Text="{Binding HealthCheckSeconds}" MaxWidth="120" HorizontalAlignment="Left" />
                                <TextBlock Style="{StaticResource Help}" Text="How often the server checks its endpoints. Default: 30" />
                                <TextBlock Style="{StaticResource Err}" Text="{Binding HealthCheckError}" />

                                <TextBlock Style="{StaticResource Label}" Text="Workspace root" />
                                <TextBox Text="{Binding WorkspaceRoot}" />
                                <TextBlock Style="{StaticResource Help}" Text="Blank: found automatically from the nearest .git folder or solution." />

                                <TextBlock Style="{StaticResource Label}" Text="Behavior config override" />
                                <TextBox Text="{Binding BehaviorConfigPath}" />
                                <TextBlock Style="{StaticResource Help}" Text="For development: path to a different config.json. Blank: the workspace's own." />

                                <CheckBox IsChecked="{Binding McpDebugLogging}" Content="MCP server debug logging" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource CheckHelp}" Text="Sets the server's console log level to Debug." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="4,8,12,4">
                    <TextBlock Style="{StaticResource Help}" Margin="0,0,0,4" Text="{Binding RestartNotice}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                        <Button Content="Discard changes" Command="{Binding DiscardCommand}" MinWidth="130" />
                        <Button Content="Restart MCP server" Command="{Binding RestartCommand}" MinWidth="140" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Services">
            <ScrollViewer DataContext="{Binding Services}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4" Width="620" HorizontalAlignment="Left">
                    <TextBlock Text="TokenSaver MCP server" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding McpStatus}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start" Command="{Binding StartMcpCommand}" />
                        <Button Content="Stop" Command="{Binding StopMcpCommand}" />
                        <Button Content="Restart" Command="{Binding RestartMcpCommand}" />
                        <Button Content="Install" Command="{Binding InstallMcpCommand}" />
                        <Button Content="Uninstall" Command="{Binding UninstallMcpCommand}" />
                    </StackPanel>

                    <TextBlock Text="SimpleModelServer" FontWeight="Bold" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding SimpleModelServerStatus}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start" Command="{Binding StartSimpleModelServerCommand}" />
                        <Button Content="Install" Command="{Binding InstallSimpleModelServerCommand}" />
                        <Button Content="Uninstall" Command="{Binding UninstallSimpleModelServerCommand}" />
                    </StackPanel>

                    <TextBlock Text="Setup" FontWeight="Bold" Margin="0,18,0,4" />
                    <TextBlock Text="Full setup installs both services, waits until they respond, then opens the install prompt."
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Run full setup" Command="{Binding FullSetupCommand}" />
                        <Button Content="Open install prompt" Command="{Binding InstallPromptCommand}" />
                        <Button Content="Refresh status" Command="{Binding RefreshCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Logs">
            <Grid DataContext="{Binding Logs}" Margin="4,12,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Width="300" Margin="0,0,8,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
                    <CheckBox IsChecked="{Binding FollowNewest}" Content="Follow newest file" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <CheckBox IsChecked="{Binding NewestFirst}" Content="Newest line first" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,6" TextWrapping="Wrap" />

                <TextBox Grid.Row="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </TabItem>
    </TabControl>
</DataTemplate>
