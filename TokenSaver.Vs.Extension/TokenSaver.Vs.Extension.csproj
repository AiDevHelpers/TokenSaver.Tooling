<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TokenSaver Visual Studio 2026 extension.

    Built on the VisualStudio.Extensibility model and hosted OUT-OF-PROCESS (VssdkCompatibleExtension
    false, RequiresInProcessHosting false on ExtensionEntrypoint). The extension process cannot load
    classic VSSDK assemblies (Microsoft.VisualStudio.Shell.15.0), so a command or tool window must not
    take a VSSDK type in its constructor or signature: one such type fails the whole command set.
    Settings, services and logs are tabs of a Remote UI tool window (Pages/TokenSaverToolWindow.cs) for that reason. Manifest
    metadata comes from ExtensionEntrypoint's ExtensionConfiguration.

    We intentionally do NOT reference the repo's libraries (TokenSaver.Config /
    TokenSaver.Client.Helpers) here — the extension is a thin client that talks to the already-running
    TokenSaver.MCP server over HTTP and controls the Windows service, which keeps the VSIX small and
    the extension reliable.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWpf>true</UseWpf>
    <VssdkCompatibleExtension>false</VssdkCompatibleExtension>
    <!-- VSEXT0010: net10 target vs the .NET 8 the VS extensibility host may load. Suppressed so CI enforcement can run;
         needs a real check on VS 18 (see docs/plans/codebase-review-fix-plan.md, Q9). -->
    <NoWarn>$(NoWarn);VSEXT0010</NoWarn>
    <!-- The Output Window extensibility API (Views().Output.CreateOutputChannelAsync, used by the
         SimpleModelServer commands to show responses) is still marked preview by the SDK. -->
    <!-- NU1701: Microsoft.VisualStudio.Sdk (needed for DialogPage/ProvideOptionPageAttribute, see
         Options/TokenSaverPackage.cs) only ships net472/netstandard2.0 assets on NuGet. That's
         expected for in-proc VSSDK-compatible extensions: these are compile-time reference
         assemblies only — at runtime the types resolve against the real Microsoft.VisualStudio.
         Shell.15.0 already loaded in devenv.exe, not this NuGet copy. -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_OUTPUTWINDOW;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Sdk" Version="17.14.40265" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="EnvDTE" Version="17.14.40260" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="SperryDev.Logger" Version="$(SperryLoggerVersion)" />
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <!-- Localized strings for %Key% placeholders in CommandConfiguration. Deployed at the .vsextension
       root (the default locale), which is where VisualStudio.Extensibility reads it. -->
  <ItemGroup>
    <Content Include="string-resources.json"
             VSIXSubPath=".vsextension"
             CopyToOutputDirectory="PreserveNewest"
             IncludeInVSIX="true" />
  </ItemGroup>

  <!-- Remote UI XAML is sent to Visual Studio as text, so it is an embedded resource named after its
       RemoteUserControl type (TokenSaver.Vs.Extension.Pages.TokenSaverToolWindowContent.xaml), not a
       compiled WPF page. -->
  <ItemGroup>
    <Page Remove="Pages\TokenSaverToolWindowContent.xaml" />
    <EmbeddedResource Include="Pages\TokenSaverToolWindowContent.xaml" />
  </ItemGroup>

  <!-- Service installers bundled beside the extension (install/uninstall commands run them via msiexec).
       TokenSaver-Setup.msi is built by scripts/build-vsix.ps1 (VS Code extension) into this path. The
       SimpleModelServer MSI comes from its own repo and is copied in the same way when present. Each item is
       skipped when its MSI is absent, so the build still succeeds without them. -->
  <ItemGroup>
    <Content Include="..\TokenSaver.VsCodeExt\bin\TokenSaver.Setup\TokenSaver-Setup.msi"
             Link="TokenSaver-Setup.msi"
             Condition="Exists('..\TokenSaver.VsCodeExt\bin\TokenSaver.Setup\TokenSaver-Setup.msi')"
             CopyToOutputDirectory="PreserveNewest"
             IncludeInVSIX="true" />
    <Content Include="..\TokenSaver.VsCodeExt\bin\SimpleModelServer.Setup\SimpleModelServer-Setup.msi"
             Link="SimpleModelServer-Setup.msi"
             Condition="Exists('..\TokenSaver.VsCodeExt\bin\SimpleModelServer.Setup\SimpleModelServer-Setup.msi')"
             CopyToOutputDirectory="PreserveNewest"
             IncludeInVSIX="true" />
    <Content Include="..\TokenSaver.VsCodeExt\INSTALL_PROMPT.md"
             Link="INSTALL_PROMPT.md"
             CopyToOutputDirectory="PreserveNewest"
             IncludeInVSIX="true" />
  </ItemGroup>

  <!-- Override the repo-wide Nerdbank.GitVersioning (3.9.50, injected by Directory.Build.props)
       up to 3.10.91 via Update so there is no duplicate PackageReference. -->
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>

</Project>
