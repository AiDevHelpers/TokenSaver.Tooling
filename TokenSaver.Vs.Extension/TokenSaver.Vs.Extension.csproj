<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <CopyBuildOutputToOutputPath>true</CopyBuildOutputToOutputPath>
    <CopyOutputSymbolsToOutputPath>false</CopyOutputSymbolsToOutputPath>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.2.32505.176" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\TokenSaver.Client.Helpers\TokenSaver.Client.Helpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Form</SubType>
    </None>
  </ItemGroup>

</Project>
