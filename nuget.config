<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for TokenSaver.

  TokenSaver.Common.* packages are built and published by the TokenSaver.Common repo.
  - CI: the workflow adds the GitHub Packages feed (rsperry79) with TOKENSAVER_READ_TOKEN before
    restore, so nothing sensitive lives in this file.
  - Local development: use the packages from TokenSaver.Common's own build, once per machine:
      cd ../Common && dotnet pack TokenSaver.Common.slnx -c Release -o artifacts
      dotnet nuget add source <full path to ../Common/artifacts> with the name tokensaver-common-local
    A local source that does not exist makes restore fail on every machine that lacks it, so
    it is added per machine rather than listed here.
-->
<configuration>
  <packageSources>
    <!-- No <clear />: per-machine sources (tokensaver-common-local) must stay visible. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
