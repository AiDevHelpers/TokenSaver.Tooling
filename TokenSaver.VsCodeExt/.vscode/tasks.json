{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "build-vsix",
      "type": "shell",
      "command": "pwsh",
      "args": ["-File", "${workspaceFolder}/../../../scripts/build-vsix.ps1"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "build-vsix-install",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-Command",
        "& '${workspaceFolder}/../../../scripts/build-vsix.ps1' && code --install-extension '${workspaceFolder}/tokensaver.vsix' --force"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$tsc"
    },
    {
      // Full rebuild+publish+install: runs scripts/build-vsix.ps1 with no flags, so it
      // does the whole pipeline — dotnet publish of TokenSaver.MCP and SimpleModelServer,
      // npm install/build, vsce package, and (since -NoInstall is NOT passed here) uninstalls
      // any existing tokensaver-vscode extension and installs the freshly built VSIX. This
      // is the same script the .esproj's PublishCommand calls, just invoked directly with
      // -NoInstall omitted so the install step actually runs for local F5 debugging.
      "label": "rebuild-publish-install-vsix",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/../../../scripts/build-vsix.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$tsc"
    },
    {
      // Opens a plain VS Code window (not the Extension Development Host) so the extension
      // runs exactly as a real user would experience it — loaded from the installed VSIX via
      // the previous task, not from --extensionDevelopmentPath. Depends on
      // rebuild-publish-install-vsix so the install always happens first.
      "label": "launch-vscode-with-installed-extension",
      "type": "shell",
      "command": "code",
      "args": ["--new-window", "${workspaceFolder}"],
      "dependsOn": "rebuild-publish-install-vsix",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}

